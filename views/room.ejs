<html translate="no">
  <head>
    <meta charset="UTF-8">
    <title>Vilard's Quiz</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/img/Logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body class="background">
    <div id="pauseMenu"></div>
    <main class="container">
      <header style="grid-area: title">
        <a href="/"><img src="/img/Title.png" alt="Back to menu"></a>
      </header>
      <section class="judgePlace" aria-label="Judge">
        <div class="neon-text" style="max-height: 100%;" id="judgeLabel"></div>
      </section>
      <section class="playersPlace" aria-label="Players">
        <div class="glow" style="margin-bottom: 8px;">Players</div>
        <div id="playerLabels"></div>
      </section>
      <section id="gamefield" class="gamefield" aria-label="Board">
        <div id="boardLoading" class="boardLoading">
          <div class="spinner" aria-hidden="true"></div>
          <p>Loading the pack&hellip;</p>
        </div>
        <div id="rounds"></div>
        <div id="questionField" class="questionField" style="display: none;"></div>
        <div id="lastAnswer" class="lastAnswer" style="display: none;"></div>
      </section>
      <section class="playersPlace2" aria-label="Players">
        <div class="glow" style="margin-bottom: 8px;">Players</div>
        <div id="playerLabels2"></div>
      </section>
      <section class="activeField" aria-label="Answer">
        <div id="announcement"></div>
        <div id="answerField"></div>
        <div id="waitForJudge" style="display: none;">Waiting for judge</div>
      </section>
      <footer id="roundControl" style="grid-area: control"></footer>
      <div style="grid-area: points"></div>
    </main>
  </body>
  <script>
    const roomName = "<%= roomName %>"
  </script>
  <script src="https://cdn.socket.io/4.6.1/socket.io.min.js"></script>
  <script src="./frontendRoom.js"></script>
</html>
