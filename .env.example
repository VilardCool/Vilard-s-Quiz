# Copy this file to .env and fill in real values (don't commit .env).
# Requires the "dotenv" package if you want .env to be loaded automatically —
# see DATABASE.md for the one-line setup.

# Simplest option — a single connection string:
DATABASE_URL=postgres://quiz_user:quiz_password@localhost:5432/quiz

# Set to "true" only if your PostgreSQL provider requires SSL
# (most managed cloud databases do; a local Docker Postgres does not).
PGSSL=false

PORT=3000
